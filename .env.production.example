# Vorlage für die Produktions-Umgebungsvariablen auf dem VPS.
# Kopieren nach ".env.production" und Werte anpassen:
#   cp .env.production.example .env.production
#
# Diese Datei wird von docker-compose.yml eingelesen (env_file) und NICHT
# committet (siehe .gitignore).

# Pfad innerhalb des Containers/Volumes - i.d.R. nicht ändern.
DATABASE_URL="file:/data/musikradio.db"
STORAGE_DIR="/data/storage"

# Unbedingt aendern! Admin-Login unter https://ihre-domain.de/admin
ADMIN_PASSWORD="bitte-aendern"

# Unbedingt aendern! Mit `openssl rand -hex 32` erzeugen.
SESSION_SECRET="bitte-aendern"

# Ziel-URL fuer den Spendenlink "Spenden fuer die Musiker*innen"
DONATION_URL="https://example.org/spenden"

SCHEDULE_TIMEZONE="Europe/Berlin"
NODE_ENV="production"
PORT="3000"
