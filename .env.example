# Datenbank (SQLite-Datei). Pfad ist relativ zu prisma/schema.prisma.
# Im Docker-Deployment auf einen absoluten Pfad im gemounteten Volume setzen,
# z.B. DATABASE_URL="file:/data/musikradio.db"
DATABASE_URL="file:./dev.db"

# Admin-Login unter /admin. Unbedingt vor dem Deployment aendern!
ADMIN_PASSWORD="changeme"

# Geheimer Schluessel zum Signieren des Admin-Session-Cookies.
# Mit z.B. `openssl rand -hex 32` erzeugen. Unbedingt vor dem Deployment aendern!
SESSION_SECRET="changeme-generate-a-random-secret"

# Verzeichnis fuer hochgeladene Audiodateien und Bilder.
# Im Docker-Deployment auf das gemountete Volume zeigen, z.B. /data/storage
STORAGE_DIR="./storage"

# Ziel-URL fuer den Spendenlink "Spenden fuer die Musiker*innen"
DONATION_URL="https://example.org/spenden"

# Zeitzone fuer den taeglichen Sendeplan (Tagesgrenze, Blockzeiten)
SCHEDULE_TIMEZONE="Europe/Berlin"
